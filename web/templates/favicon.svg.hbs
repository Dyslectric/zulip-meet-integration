<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16">
    <style>
        @font-face {
        font-family: 'Source Sans 3';
        font-style: normal;
        font-weight: 700;
        src: url({{{favicon_font_url_html}}}) format('truetype');
        }
    </style>
    <linearGradient id="a" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#2DD4BF" />
        <stop offset="1" stop-color="#0E7490" />
    </linearGradient>
    <path d="M1.5976 5.0744A1.3992 1.3992 0 0 1 4.396 5.0744L4.396 10.9256A1.3992 1.3992 0 0 1 1.5976 10.9256ZM5.1592 2.3608A1.3992 1.3992 0 0 1 7.9576 2.3608L7.9576 13.6392A1.3992 1.3992 0 0 1 5.1592 13.6392ZM8.7208 4.0568A1.3992 1.3992 0 0 1 11.5192 4.0568L11.5192 11.9432A1.3992 1.3992 0 0 1 8.7208 11.9432ZM12.2824 6.2616A1.3992 1.3992 0 0 1 15.0808 6.2616L15.0808 9.7384A1.3992 1.3992 0 0 1 12.2824 9.7384Z" fill="url(#a)" />
    <text x="15" y="15" text-anchor="end"
      font-family="'Source Sans 3'" font-weight="bold" letter-spacing="-0.5"
      fill="white" stroke="white" stroke-width="2" stroke-linejoin="round" opacity=".5"
      {{#if count_long}}font-size="9" textLength="14" lengthAdjust="spacingAndGlyphs"{{else}}font-size="11"{{/if}}>
        {{count}}
    </text>
    <text x="15" y="15" text-anchor="end"
      font-family="'Source Sans 3'" font-weight="bold" letter-spacing="-0.5"
      {{#if count_long}}font-size="9" textLength="14" lengthAdjust="spacingAndGlyphs"{{else}}font-size="11"{{/if}}>
        {{count}}
    </text>
    {{#if have_pm}}
    <circle cx="14" cy="4" r="2" fill="#f00" />
    {{/if}}
</svg>

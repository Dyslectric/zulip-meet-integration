<div id="channel-subscription-permissions" class="settings-subsection-parent">
    <div class="channel-subscription-permissions-title-container {{#if is_stream_edit}}subsection-header{{/if}}">
        <h4 class="stream_setting_subsection_title">{{t "Subscription management"}}</h4>
        {{#if is_stream_edit}}
            {{> ../settings/settings_save_discard_widget section_name="subscription-permissions" show_save_discard_buttons=true}}
        {{/if}}
    </div>

    {{#if is_stream_edit}}
        <div class="stream-permissions-warning-banner"></div>
        {{> channel_type .
          channel_privacy_widget_name="channel_privacy" }}

        <div class="default-stream">
            {{> ../settings/settings_checkbox
              prefix=prefix
              setting_name="is_default_stream"
              is_checked=check_default_stream
              label=(t "Default channel for new users")
              help_link="/help/set-default-channels-for-new-users"
              }}
        </div>
    {{/if}}

    {{> ../settings/group_setting_value_pill_input
      setting_name="can_subscribe_group"
      label=group_setting_labels.can_subscribe_group
      prefix=prefix }}

    {{> ../settings/group_setting_value_pill_input
      setting_name="can_add_subscribers_group"
      label=group_setting_labels.can_add_subscribers_group
      prefix=prefix }}

    {{> ../settings/group_setting_value_pill_input
      setting_name="can_remove_subscribers_group"
      label=group_setting_labels.can_remove_subscribers_group
      prefix=prefix }}

    {{#unless is_stream_edit}}
        {{#if is_admin}}
        <div class="default-push-notifications">
            {{> ../settings/settings_checkbox
              prefix=prefix
              setting_name="default_push_notifications"
              is_checked=false
              is_disabled=disable_push_notifications
              label=(t "Mobile push notifications enabled by default")
              tooltip_message=push_notifications_tooltip
              }}
        </div>
        {{/if}}
    {{/unless}}
</div>

<div id="channel-messaging-permissions" class="settings-subsection-parent">
    <div class="channel-messaging-permissions-title-container {{#if is_stream_edit}}subsection-header{{/if}}">
        <h4 class="stream_setting_subsection_title">{{t "Messaging permissions"}}</h4>
        {{#if is_stream_edit}}
            {{> ../settings/settings_save_discard_widget section_name="messaging-permissions" show_save_discard_buttons=true}}
        {{/if}}
    </div>

    {{> ../settings/group_setting_value_pill_input
      setting_name="can_send_message_group"
      label=group_setting_labels.can_send_message_group
      prefix=prefix
      help_link="/help/channel-posting-policy" }}

    {{> ../settings/group_setting_value_pill_input
      setting_name="can_create_topic_group"
      label=group_setting_labels.can_create_topic_group
      prefix=prefix
      help_link="/help/configure-who-can-start-new-topics" }}

    {{! A lounge's counterpart of "who can start new topics", and hidden with
    everything else: a lounge is the only kind of channel with rooms to start.
    Deliberately separate from who may subscribe — a lounge where everyone
    listens and a few convene is a reasonable thing to want, and tying the two
    together would force that to be expressed by keeping people out of the
    lounge itself. }}
    <div class="create-rooms-group-setting{{#unless (lookup sub "is_lounge")}} hide{{/unless}}">
        {{> ../settings/group_setting_value_pill_input
          setting_name="can_create_rooms_group"
          label=group_setting_labels.can_create_rooms_group
          prefix=prefix }}
    </div>

    {{! A channel property, so it belongs to this subsection's save/discard
    widget rather than to the personal settings, whose change handler only
    accepts subscription properties. Only offered when editing: a new
    channel allows calls, and the creation form does not send it. }}
    {{! On the creation form there is no `sub` yet, so the checkbox reflects what
    the server would do anyway: a new channel allows calls. `(not is_stream_edit)`
    is how that default is expressed without a sub to read it from. }}
    {{! What kind of channel this is. The three are mutually exclusive — a text
    channel has topics; a voice channel is one room that is always there, with a
    single thread of text beside it or none at all; a lounge is many rooms, none
    of which outlast the people in them — so this is one control rather than a
    checkbox each, which is what let you ask for two at once. It rides the normal
    save/discard machinery under a synthetic property name and expands into
    voice_video_enabled and is_lounge on the way out; see settings_data. }}
    <div class="channel-kind-setting input-group">
        <label for="{{prefix}}channel_kind" class="settings-field-label">{{t "Channel kind"}}</label>
        <select name="channel-kind-setting" id="{{prefix}}channel_kind" class="prop-element settings_select bootstrap-focus-style" data-setting-widget-type="string">
            <option value="text" {{#unless (or (lookup sub "voice_video_enabled") (lookup sub "is_lounge"))}}selected{{/unless}}>{{t "Text channel" }}</option>
            <option value="voice" {{#if (lookup sub "voice_video_enabled")}}selected{{/if}}>{{t "Voice channel" }}</option>
            <option value="lounge" {{#if (lookup sub "is_lounge")}}selected{{/if}}>{{t "Lounge" }}</option>
        </select>
        {{! A web-public voice channel or lounge is open to whoever can see it,
        unauthenticated visitors included. Said plainly, because it is the one
        combination whose consequences are not obvious from the two words. }}
        {{#if (lookup sub "is_web_public")}}
        <div class="settings-field-hint">{{t "This channel is web-public: anyone on the internet can see it, and can join its calls without an account." }}</div>
        {{/if}}
        {{! A voice channel is either single-threaded or has no text at all; this
        is the switch between the two. Only meaningful on a voice channel, so it
        hides with anything else — a lounge does not get it, because it stores no
        text in the first place and so has nothing to switch off. }}
        <div class="text-chat-disabled-setting{{#unless (lookup sub "voice_video_enabled")}} hide{{/unless}}">
            {{> ../settings/settings_checkbox
              prefix=prefix
              setting_name="text_chat_disabled"
              is_checked=(lookup sub "text_chat_disabled")
              label=(t "Disable text chat in this channel")
              }}
        </div>
        {{! Who has to already be in a call before anyone else may come in. A door
        policy, not a kill switch: once the doorman leaves nobody new may enter,
        and the people already talking are never cut off. Only meaningful where
        there are calls, so it hides on a text channel.

        Offered only when editing, like the channel-kind controls above and for
        the same reason: the creation form does not send it, so a control here
        would quietly do nothing. A new channel starts at anarchy. }}
        {{#if is_stream_edit}}
        <div class="call-door-policy-setting{{#unless (or (lookup sub "voice_video_enabled") (lookup sub "is_lounge"))}} hide{{/unless}}">
            <label for="{{prefix}}call_door_policy" class="settings-field-label">{{t "Who must be in a call for others to join"}}</label>
            <select name="call-door-policy-setting" id="{{prefix}}call_door_policy" class="prop-element settings_select bootstrap-focus-style" data-setting-widget-type="string">
                {{> ../settings/dropdown_options_widget option_values=(object_values call_door_policy_values)}}
            </select>
        </div>
        {{/if}}
    </div>

    <div class="input-group">
        {{! A plainer way to say topics_policy = empty_topic_only: everything is
        posted to the single unnamed topic. Drives the dropdown below, so
        saving goes through the normal settings machinery. }}
        <div class="settings-checkbox-wrapper single-threaded-channel-setting">
            <label class="checkbox">
                <input type="checkbox" class="single-threaded-channel-toggle inline-block" id="{{prefix}}single_threaded_channel" {{#if (eq (lookup sub "topics_policy") "empty_topic_only")}}checked="checked"{{/if}} />
                <span class="rendered-checkbox"></span>
            </label>
            <label for="{{prefix}}single_threaded_channel" class="inline">{{t "Single-threaded channel"}}</label>
        </div>
        <label for="{{prefix}}topics_policy" class="settings-field-label">{{> stream_topics_policy_label .}}</label>
        <select name="stream-topics-policy-setting" id="{{prefix}}topics_policy" class="prop-element settings_select bootstrap-focus-style" data-setting-widget-type="string">
            {{> ../settings/dropdown_options_widget option_values=(object_values stream_topics_policy_values)}}
        </select>
        {{> topics_already_exist_error .}}
    </div>
</div>

<div id="channel-moderation-permissions" class="settings-subsection-parent">
    <div class="channel-moderation-permissions-title-container {{#if is_stream_edit}}subsection-header{{/if}}">
        <h4 class="stream_setting_subsection_title">{{t "Moderation permissions"}}</h4>
        {{#if is_stream_edit}}
            {{> ../settings/settings_save_discard_widget section_name="moderation-permissions" show_save_discard_buttons=true}}
        {{/if}}
    </div>

    {{> ../settings/group_setting_value_pill_input
      setting_name="can_move_messages_within_channel_group"
      label=group_setting_labels.can_move_messages_within_channel_group
      prefix=prefix }}

    {{> ../settings/group_setting_value_pill_input
      setting_name="can_move_messages_out_of_channel_group"
      label=group_setting_labels.can_move_messages_out_of_channel_group
      prefix=prefix }}

    {{> ../settings/group_setting_value_pill_input
      setting_name="can_resolve_topics_group"
      label=group_setting_labels.can_resolve_topics_group
      prefix=prefix }}

    {{> ../settings/group_setting_value_pill_input
      setting_name="can_delete_any_message_group"
      label=group_setting_labels.can_delete_any_message_group
      prefix=prefix }}

    {{> ../settings/group_setting_value_pill_input
      setting_name="can_delete_own_message_group"
      label=group_setting_labels.can_delete_own_message_group
      prefix=prefix }}
</div>

<div id="channel-administrative-permissions" class="settings-subsection-parent">
    <div class="channel-administrative-permissions-title-container {{#if is_stream_edit}}subsection-header{{/if}}">
        <h4 class="stream_setting_subsection_title">{{t "Administrative permissions"}}</h4>
        {{#if is_stream_edit}}
            {{> ../settings/settings_save_discard_widget section_name="administrative-permissions" show_save_discard_buttons=true}}
        {{/if}}
    </div>
    <div class="admin-permissions-tip">
        {{t 'Organization administrators can automatically administer all channels.'}}
    </div>
    {{> ../settings/group_setting_value_pill_input
      setting_name="can_administer_channel_group"
      label=group_setting_labels.can_administer_channel_group
      prefix=prefix }}

    {{#if (or is_owner is_stream_edit)}}
        <div>
            <div class="input-group message-retention-setting-group time-limit-setting">
                <label class="dropdown-title settings-field-label" for="{{prefix}}message_retention_days">{{t "Message retention period" }}
                    {{> ../help_link_widget link="/help/message-retention-policy" }}
                </label>

                {{> ../settings/upgrade_tip_widget .}}

                <select name="stream_message_retention_setting"
                  class="stream_message_retention_setting prop-element settings_select bootstrap-focus-style"
                  id="{{prefix}}message_retention_days"
                  data-setting-widget-type="message-retention-setting">
                    <option value="realm_default">{{t "Organization default {org_level_message_retention_setting}" }}</option>
                    <option value="unlimited">{{t 'Retain forever' }}</option>
                    <option value="custom_period">{{t 'Custom' }}</option>
                </select>

                <div class="dependent-settings-block stream-message-retention-days-input">
                    <label class="inline-block" for="{{prefix}}stream_message_retention_custom_input">
                        {{t 'Retention period (days)' }}:
                    </label>
                    <input type="text" autocomplete="off"
                      name="stream-message-retention-days"
                      class="stream-message-retention-days message-retention-setting-custom-input time-limit-custom-input"
                      id="{{prefix}}stream_message_retention_custom_input" />
                </div>
            </div>
        </div>
    {{/if}}
</div>
